# Major Gym — Windows (.NET / WPF) — .gitignore
#
# Goal: keep the repository to source + the vendor DLLs that are required to build
# (SecuGen SDK under vendor/SecuGen — those are intentionally NOT ignored, see below).
# Everything that is regenerated by a local build or by an IDE is ignored.

# ---- Build output ----
[Bb]in/
[Oo]bj/
[Bb]uild/
out/
publish/
*.pdb

# ---- Packaged CI artifact staging (created locally by build scripts, not source) ----
artifact-staging/
*.zip
!vendor/**/*.zip

# ---- Visual Studio / Rider / VS Code ----
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# ---- NuGet ----
*.nupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/
.nuget/

# ---- Test results ----
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# ---- OS / machine-specific junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs / crash dumps ----
*.log
*.dmp

# ---- IMPORTANT: do NOT ignore vendored native/managed dependencies ----
# The SecuGen Windows SDK DLLs under vendor/SecuGen/{x64,x86} are required, checked-in
# binaries the build and runtime depend on — do not add a blanket *.dll rule above that
# would catch them, and do not add vendor/ to this file.
