<UserControl x:Class="MajorGym.App.Views.RenewedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
    <ScrollViewer Padding="24,20,24,90">
        <StackPanel MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="{StaticResource GymSuccess}"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding HeadingText}" Style="{StaticResource GymHeading}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Member.Name}" Style="{StaticResource GymBody}" HorizontalAlignment="Center" Margin="0,4,0,20"/>

            <Border Style="{StaticResource GymCard}" HorizontalAlignment="Center" Padding="14" Margin="0,0,0,10">
                <StackPanel HorizontalAlignment="Center">
                    <Border Background="White" CornerRadius="8" Padding="10">
                        <Image Source="{Binding QrImage}" Width="200" Height="200"/>
                    </Border>
                    <TextBlock Text="{Binding QrStatusText}" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GymTextFaint}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsQrValid}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource GymDanger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="This QR replaces any earlier one — old QRs no longer work." Foreground="{StaticResource GymTextFaint}"
                               FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ShareStatus}" Foreground="{StaticResource GymWarning}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,0,0,10" Visibility="{Binding ShareStatus, Converter={StaticResource NullToVis}}"/>

            <StackPanel Visibility="{Binding JustRenewed, Converter={StaticResource BoolToVis}}">
                <Button Content="Share Renewal Update" Style="{StaticResource GymPrimaryButton}" Command="{Binding ShareRenewalCommand}" Margin="0,4,0,10"/>
                <Button Content="Done" Command="{Binding DoneCommand}" HorizontalAlignment="Center" Background="Transparent"
                        BorderThickness="0" Foreground="{StaticResource GymTextMuted}"/>
            </StackPanel>
            <Button Content="Done" Style="{StaticResource GymPrimaryButton}" Command="{Binding DoneCommand}"
                    Visibility="{Binding JustRenewed, Converter={StaticResource InverseBoolToVis}}"/>
        </StackPanel>
    </ScrollViewer>
        <Button Style="{StaticResource GymBackButton}" Command="{Binding DoneCommand}" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="16,20,0,0" ToolTip="Back to member profile"/>
    </Grid>
</UserControl>
