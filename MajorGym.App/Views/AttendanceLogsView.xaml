<UserControl x:Class="MajorGym.App.Views.AttendanceLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MajorGym.App.Controls"
             Loaded="OnLoaded" Unloaded="OnUnloaded" PreviewMouseDown="OnViewPreviewMouseDown">

    <Grid Background="{StaticResource GymBg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,20,16,24">

                <!-- Header: title + date subtitle; settings and calendar icon buttons -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ATTENDANCE LOGS" Style="{StaticResource GymHeaderText}" FontSize="22" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding DateSubtitle}" Foreground="{StaticResource GymTextMuted}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource GymTextButton}" Padding="10,8" ToolTip="Attendance count settings">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource GymIconFont}" FontSize="18" Foreground="{StaticResource GymAccent}"/>
                        </Button>
                        <Button x:Name="HeaderDateButton" Command="{Binding OpenDatePickerCommand}" Style="{StaticResource GymTextButton}" Padding="10,8" ToolTip="Pick date">
                            <TextBlock Text="&#xE787;" FontFamily="{StaticResource GymIconFont}" FontSize="18" Foreground="{StaticResource GymAccent}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Stat cards: Present / Morning / Evening -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource GymGlassCard}" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="PRESENT" Foreground="{StaticResource GymTextFaint}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding PresentText}" Foreground="{StaticResource GymAccent}" FontFamily="{StaticResource GymHeaderFont}" FontSize="30" Margin="0,8,0,0" HorizontalAlignment="Center"
                                       Visibility="{Binding HasPresentText, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource GymGlassCard}" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="MORNING" Foreground="{StaticResource GymTextFaint}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding MorningText}" Foreground="{StaticResource GymAccent}" FontFamily="{StaticResource GymHeaderFont}" FontSize="30" Margin="0,8,0,0" HorizontalAlignment="Center"
                                       Visibility="{Binding HasMorningText, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource GymGlassCard}" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="EVENING" Foreground="{StaticResource GymTextFaint}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding EveningText}" Foreground="{StaticResource GymAccent}" FontFamily="{StaticResource GymHeaderFont}" FontSize="30" Margin="0,8,0,0" HorizontalAlignment="Center"
                                       Visibility="{Binding HasEveningText, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Search (radius 12, accent search icon, placeholder) -->
                <Border Background="{StaticResource GymSurfaceCard}" BorderBrush="{StaticResource GymBorder}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource GymIconFont}" FontSize="16" Foreground="{StaticResource GymAccent}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource GymText}" CaretBrush="{StaticResource GymAccent}"
                                 FontSize="14" Padding="10,13" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Search by name, phone or ID proof" Foreground="{StaticResource GymTextFaint}" FontSize="14"
                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Select Date + Filter tiles -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                    <Border x:Name="DateTile" Grid.Column="0" Background="{StaticResource GymSurfaceCard}" BorderBrush="{StaticResource GymBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="12" Cursor="Hand">
                        <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding OpenDatePickerCommand}"/></Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" FontFamily="{StaticResource GymIconFont}" FontSize="18" Foreground="{StaticResource GymAccent}" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="SELECT DATE" Foreground="{StaticResource GymTextFaint}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedDateText}" Foreground="{StaticResource GymText}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="FilterTile" Grid.Column="2" Background="{StaticResource GymSurfaceCard}" BorderBrush="{StaticResource GymBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="12" Cursor="Hand">
                        <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding ToggleFilterMenuCommand}"/></Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71C;" FontFamily="{StaticResource GymIconFont}" FontSize="18" Foreground="{StaticResource GymAccent}" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="FILTER" Foreground="{StaticResource GymTextFaint}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding FilterLabel}" Foreground="{StaticResource GymText}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Calendar popup (Android DatePickerDialog) -->
                    <!-- StaysOpen="True" + manual click-away (OnViewPreviewMouseDown): a StaysOpen="False" popup
                         is closed by WPF on the very mouse-up/capture change that follows the click which
                         opened it, and by the Calendar's own capture handling when a month/year/day is
                         clicked — that is what made the picker and filter "back off" before anything could
                         be selected. -->
                    <Popup x:Name="DatePopup" PlacementTarget="{Binding ElementName=DateTile}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
                           IsOpen="{Binding IsDatePickerOpen, Mode=TwoWay}">
                        <Border Background="{StaticResource GymSurface2}" BorderBrush="{StaticResource GymBorder}" BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,4,0,8">
                            <Calendar x:Name="Cal" SelectedDate="{Binding SelectedDate, Mode=TwoWay}" DisplayDate="{Binding SelectedDate, Mode=OneWay}"
                                      PreviewMouseUp="OnCalendarPreviewMouseUp"/>
                        </Border>
                    </Popup>

                    <!-- Filter dropdown (Android DropdownMenu) -->
                    <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterTile}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
                           IsOpen="{Binding IsFilterMenuOpen, Mode=TwoWay}">
                        <Border Background="{StaticResource GymSurface2}" BorderBrush="{StaticResource GymBorder}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,4,0,8" MinWidth="170">
                            <ItemsControl ItemsSource="{Binding FilterOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" HorizontalContentAlignment="Left" Style="{StaticResource GymTextButton}"
                                                Foreground="{StaticResource GymText}" FontSize="13"
                                                Command="{Binding Command}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Empty message -->
                <TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource GymTextFaint}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,24,0,0"
                           Visibility="{Binding HasEmptyMessage, Converter={StaticResource BoolToVis}}"/>

                <!-- Attendance rows (Android AttendanceRecordCard) -->
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GymGlassCard}" Padding="12" Margin="0,0,0,10" Cursor="Hand">
                                <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/></Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:StatusRing Grid.Column="0" Width="48" Height="48" RingSize="48"
                                                         PhotoPath="{Binding PhotoPath}" MemberName="{Binding MemberName}" Status="{Binding Status}"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MemberName}" Foreground="{StaticResource GymText}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Phone}" Foreground="{StaticResource GymTextMuted}" FontSize="12"/>
                                        <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource GymTextFaint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource GymIconFont}" FontSize="11" Foreground="{StaticResource GymSuccess}" VerticalAlignment="Center"/>
                                            <TextBlock Text="PRESENT" Foreground="{StaticResource GymSuccess}" FontSize="11" FontWeight="Bold" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource GymText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding SessionText}" Foreground="{StaticResource GymTextFaint}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Attendance Count Settings dialog (Android AlertDialog) -->
        <Grid Background="{StaticResource GymScrim}" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource GymSurfaceCard}" BorderBrush="{StaticResource GymBorder}" BorderThickness="1" CornerRadius="16"
                    Padding="20" MaxWidth="360" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Attendance Count Settings" Foreground="{StaticResource GymText}" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Each count can be shown or hidden independently. The card and its label always stay visible."
                               Foreground="{StaticResource GymTextFaint}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,14"/>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Present Count" Foreground="{StaticResource GymText}" FontSize="13" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding ShowPresent, Mode=TwoWay}" Style="{StaticResource GymSwitch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Morning Count" Foreground="{StaticResource GymText}" FontSize="13" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding ShowMorning, Mode=TwoWay}" Style="{StaticResource GymSwitch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Evening Count" Foreground="{StaticResource GymText}" FontSize="13" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding ShowEvening, Mode=TwoWay}" Style="{StaticResource GymSwitch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Button Content="Done" Command="{Binding CloseSettingsCommand}" Style="{StaticResource GymTextButton}"
                            Foreground="{StaticResource GymAccent}" FontWeight="Bold" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
