<UserControl x:Class="MajorGym.App.Views.AttendanceLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource GymBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,20,20,8" Orientation="Horizontal">
            <Button Content="&#8592;" Command="{Binding BackCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource GymTextMuted}" Margin="0,0,12,0"/>
            <TextBlock Text="Attendance Logs" Style="{StaticResource GymHeading}"/>
            <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource GymAccent}" HorizontalAlignment="Right" Margin="24,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,0,20,8" HorizontalAlignment="Center">
            <Button Content="&#8249; Newer" Command="{Binding NewerDayCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource GymAccent}"/>
            <TextBlock Text="{Binding DayLabel}" Style="{StaticResource GymBody}" Margin="16,4,16,0" VerticalAlignment="Center"/>
            <Button Content="Older &#8250;" Command="{Binding OlderDayCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource GymAccent}"/>
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="3" Margin="20,0,20,12">
            <Border Style="{StaticResource GymCard}" Margin="0,0,4,0" Visibility="{Binding PresentVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding PresentCount}" Foreground="{StaticResource GymSuccess}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Present" Style="{StaticResource GymBody}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GymCard}" Margin="4,0,4,0" Visibility="{Binding MorningVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding MorningCount}" Foreground="{StaticResource GymAccent}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Morning" Style="{StaticResource GymBody}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GymCard}" Margin="4,0,0,0" Visibility="{Binding EveningVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding EveningCount}" Foreground="{StaticResource GymViolet}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Evening" Style="{StaticResource GymBody}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3">
            <TextBlock Text="No attendance recorded on this day." Style="{StaticResource GymBody}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasDays, Converter={StaticResource InverseBoolToVis}}"/>
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Rows}" Margin="20,0,20,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GymCard}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding MemberName}" Foreground="{StaticResource GymText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Session}" Style="{StaticResource GymBody}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeOfDay}" Style="{StaticResource GymBody}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
