<UserControl x:Class="MajorGym.App.Views.RegisteredView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24,20,24,90">
        <StackPanel MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="{StaticResource GymSuccess}"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Text="MEMBERSHIP ACTIVATED" Style="{StaticResource GymHeading}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Member.Name}" Style="{StaticResource GymBody}" HorizontalAlignment="Center" Margin="0,4,0,20"/>

            <Border Style="{StaticResource GymCard}" HorizontalAlignment="Center" Padding="14" Margin="0,0,0,10">
                <StackPanel HorizontalAlignment="Center">
                    <Border Background="White" CornerRadius="8" Padding="10">
                        <Image Source="{Binding QrImage}" Width="200" Height="200"/>
                    </Border>
                    <TextBlock Text="{Binding MemberIdShortText}" Foreground="{StaticResource GymTextFaint}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding QrValidUntilText}" Foreground="{StaticResource GymTextFaint}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ShareStatus}" Foreground="{StaticResource GymWarning}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,0,0,10" Visibility="{Binding ShareStatus, Converter={StaticResource NullToVis}}"/>

            <Button Content="Share Welcome Message" Style="{StaticResource GymPrimaryButton}" Command="{Binding ShareWelcomeCommand}"
                    HorizontalAlignment="Stretch" Margin="0,4,0,10"/>
            <Button Content="Enroll Fingerprint Now" Command="{Binding EnrollFingerprintCommand}" HorizontalAlignment="Stretch"
                    Padding="16,10" Margin="0,0,0,10" Background="{StaticResource GymSurface2}" Foreground="{StaticResource GymText}"/>
            <Button Content="Done" Command="{Binding DoneCommand}" HorizontalAlignment="Center" Background="Transparent"
                    BorderThickness="0" Foreground="{StaticResource GymTextMuted}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
