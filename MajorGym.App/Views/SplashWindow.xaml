<Window x:Class="MajorGym.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Major Gym" WindowStyle="None" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Width="420" Height="800" Background="{StaticResource GymBg}"
        ShowInTaskbar="False">
    <Grid>
        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                      MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed"/>
    </Grid>
</Window>
