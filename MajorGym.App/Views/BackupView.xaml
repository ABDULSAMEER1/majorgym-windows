<UserControl x:Class="MajorGym.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{StaticResource GymBg}">
        <StackPanel Margin="20">
            <Button Content="&#8592; Back" Command="{Binding BackCommand}" HorizontalAlignment="Left"
                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource GymTextMuted}" Margin="0,0,0,12"/>
            <TextBlock Text="Backup" Style="{StaticResource GymHeading}" Margin="0,0,0,4"/>
            <TextBlock Text="Local backups only — nothing is uploaded anywhere." Style="{StaticResource GymBody}" Margin="0,0,0,16" TextWrapping="Wrap"/>

            <Border Style="{StaticResource GymCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Create Backup" Foreground="{StaticResource GymText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Saves every member, attendance record, and archived member (including photos and fingerprint data) into one file you choose." Style="{StaticResource GymBody}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button Content="Export Backup" Command="{Binding ExportCommand}" Style="{StaticResource GymPrimaryButton}"/>
                    <Button Content="Share Backup File" Command="{Binding ShareCommand}" Background="Transparent" BorderThickness="1"
                            BorderBrush="{StaticResource GymBorder}" Foreground="{StaticResource GymAccent}" Margin="0,8,0,0" Padding="16,10"
                            Visibility="{Binding CanShare, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GymCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Restore Backup" Foreground="{StaticResource GymText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Choose a previously-saved backup file (.zip or .json) to restore from." Style="{StaticResource GymBody}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button Content="Import Backup" Command="{Binding RequestImportCommand}" Background="Transparent" BorderThickness="1"
                            BorderBrush="{StaticResource GymBorder}" Foreground="{StaticResource GymText}" Padding="16,10"/>

                    <Border Background="{StaticResource GymSurface2}" CornerRadius="12" Padding="16" Margin="0,12,0,0"
                            Visibility="{Binding IsConfirmingImport, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Restore this backup?" Foreground="{StaticResource GymText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Members, attendance, and archived members from this file will be added to (or merged with) what's already on this PC. This cannot be undone."
                                       Style="{StaticResource GymBody}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Command="{Binding CancelImportCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource GymTextMuted}" Margin="0,0,16,0"/>
                                <Button Content="Restore" Command="{Binding ConfirmImportCommand}" Background="{StaticResource GymDanger}" Foreground="White" BorderThickness="0" Padding="16,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource GymSuccess}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource GymDanger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Content="Backup History" Command="{Binding GoHistoryCommand}" Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource GymAccent}" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
