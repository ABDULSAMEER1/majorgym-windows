<UserControl x:Class="MajorGym.App.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:MajorGym.App.Controls">
    <!-- Android ProfileScreen (Screens.kt ~1268-1512), same order: back arrow + header,
         StatusRing/name/StatusBadge/days-remaining, info card (Phone/Joined/Renewed?/Expires/
         Current Plan/Due Amount/ID Proof/Fingerprint), Due Payment card (only while Fee>0), ID
         Proof Photo card, action button rows (Renew/Edit/Delete, View-or-Regenerate
         QR/Enroll-or-Re-enroll Fingerprint, Remove Fingerprint-if-enrolled), HISTORY list. -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" HorizontalAlignment="Stretch" Margin="16,20,16,24">

                <DockPanel Margin="0,0,0,16">
                    <Button DockPanel.Dock="Left" Style="{StaticResource GymBackButton}" Command="{Binding BackCommand}"/>
                    <TextBlock Text="MEMBER PROFILE" Style="{StaticResource GymHeaderText}"/>
                </DockPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                    <ctl:StatusRing PhotoPath="{Binding Member.PhotoPath}" MemberName="{Binding Member.Name}" Status="{Binding Status}"
                                    RingSize="96" Cursor="Hand">
                        <ctl:StatusRing.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ViewPhotoCommand}"/>
                        </ctl:StatusRing.InputBindings>
                    </ctl:StatusRing>
                    <TextBlock Text="{Binding Member.Name}" Foreground="{StaticResource GymText}" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,12,0,6"/>
                    <ctl:StatusBadge Status="{Binding Status}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding DaysRemainingText}" Foreground="{StaticResource GymTextFaint}" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border Background="{StaticResource GymSurfaceCard}" BorderBrush="{StaticResource GymBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <ctl:ProfileRow Label="Phone" Value="{Binding Member.Phone}"/>
                        <ctl:ProfileRow Label="Joined" Value="{Binding JoinedText}"/>
                        <ctl:ProfileRow Label="Renewed" Value="{Binding LastRenewedText}"
                                        Visibility="{Binding LastRenewedText, Converter={StaticResource NullToVis}}"/>
                        <ctl:ProfileRow Label="Expires" Value="{Binding ExpiresText}"/>
                        <ctl:ProfileRow Label="Current Plan" Value="{Binding Member.Plan}"/>
                        <ctl:ProfileRow Label="Due Amount" Value="{Binding DueAmountText}">
                            <ctl:ProfileRow.Style>
                                <Style TargetType="ctl:ProfileRow">
                                    <Setter Property="ValueBrush" Value="{StaticResource GymSuccess}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDue}" Value="True">
                                            <Setter Property="ValueBrush" Value="{StaticResource GymDanger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ctl:ProfileRow.Style>
                        </ctl:ProfileRow>
                        <ctl:ProfileRow Label="ID Proof" Value="{Binding IdProofText}"/>
                        <ctl:ProfileRow Label="Fingerprint" Value="{Binding FingerprintStatusText}" IsLast="True"/>
                    </StackPanel>
                </Border>

                <!-- Due Payment — only while there's something due. -->
                <Border Background="{StaticResource GymSurfaceCard}" BorderBrush="{StaticResource GymBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,14"
                        Visibility="{Binding HasDue, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="DUE PAYMENT" Style="{StaticResource GymSectionLabel}" Margin="0,0,0,10"/>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" Text="Due Amount" Foreground="{StaticResource GymTextMuted}" FontSize="13"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DueAmountText}" Foreground="{StaticResource GymDanger}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Text="AMOUNT PAID (₹)" Style="{StaticResource GymFieldLabel}"/>
                        <TextBox Text="{Binding AmountPaidText, UpdateSourceTrigger=PropertyChanged}" Tag="Enter amount being paid now"
                                 Style="{StaticResource GymTextBox}" ctl:InputGuard.Mode="Digits" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding PaymentError}" Style="{StaticResource GymFieldError}" TextWrapping="Wrap"
                                   Visibility="{Binding PaymentError, Converter={StaticResource NullToVis}}"/>
                        <Button Content="Save Payment" Command="{Binding RecordPaymentCommand}" Style="{StaticResource GymPrimaryButtonLarge}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ID Proof Photo -->
                <Border Background="{StaticResource GymSurfaceCard}" BorderBrush="{StaticResource GymBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ID PROOF PHOTO" Style="{StaticResource GymSectionLabel}" Margin="0,0,0,10"/>
                        <Border CornerRadius="12" Height="140" ClipToBounds="True" Cursor="Hand"
                                Visibility="{Binding HasIdProofPhoto, Converter={StaticResource BoolToVis}}">
                            <Border.Background><ImageBrush ImageSource="{Binding Member.IdProofPhotoPath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill"/></Border.Background>
                            <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding ViewIdPhotoCommand}"/></Border.InputBindings>
                        </Border>
                        <TextBlock Text="No ID Proof Photo" Foreground="{StaticResource GymTextFaint}" FontSize="13"
                                   Visibility="{Binding HasIdProofPhoto, Converter={StaticResource InverseBoolToVis}}"/>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <Button Content="Renew" Command="{Binding RenewCommand}" Style="{StaticResource GymActionButton}" Margin="0,0,4,0"/>
                    <Button Content="Edit" Command="{Binding EditCommand}" Style="{StaticResource GymActionButtonMuted}" Margin="4,0,4,0"/>
                    <Button Content="Delete" Command="{Binding RequestDeleteCommand}" Style="{StaticResource GymActionButtonDanger}" Margin="4,0,0,0"/>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <Button Content="{Binding QrButtonText}" Command="{Binding ViewQrCommand}" Style="{StaticResource GymActionButton}" Margin="0,0,4,0"/>
                    <Button Content="{Binding EnrollButtonText}" Command="{Binding EnrollFingerprintCommand}" Style="{StaticResource GymActionButton}" Margin="4,0,0,0"/>
                </UniformGrid>
                <!-- Android "Fix #11": only shown once a fingerprint exists. -->
                <Button Content="Remove Fingerprint" Command="{Binding RequestRemoveFingerprintCommand}" Style="{StaticResource GymActionButtonDanger}" Margin="0,0,0,16"
                        Visibility="{Binding HasFingerprint, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="HISTORY" Style="{StaticResource GymSectionLabel}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding HistoryEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource GymSurfaceCard}" BorderBrush="{StaticResource GymBorder}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Fee, Converter={StaticResource MoneyFormat}}" Foreground="{StaticResource GymGold}"
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource GymText}" FontSize="13" FontWeight="Medium">
                                            <Run Text="{Binding Type, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Plan, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="{StaticResource GymTextMuted}" FontSize="11">
                                            <Run Text="{Binding DateMillis, Converter={StaticResource DateFormat}, Mode=OneWay}"/><Run Text=" → "/>
                                            <Run Text="{Binding ExpiryMillis, Converter={StaticResource DateFormat}, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- "Delete member" AlertDialog -->
        <Grid Background="{StaticResource GymScrim}" Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource GymSurfaceCard}" CornerRadius="24" Padding="24" MaxWidth="340" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <StackPanel>
                    <TextBlock Text="Delete member" Foreground="{StaticResource GymText}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Foreground="{StaticResource GymTextMuted}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,20">
                        <Run Text="Delete "/><Run Text="{Binding Member.Name, Mode=OneWay}"/><Run Text="? This cannot be undone."/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" Style="{StaticResource GymTextButton}"/>
                        <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}" Style="{StaticResource GymTextButton}" Foreground="{StaticResource GymDanger}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- "Remove fingerprint" AlertDialog -->
        <Grid Background="{StaticResource GymScrim}" Visibility="{Binding IsConfirmingRemoveFingerprint, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource GymSurfaceCard}" CornerRadius="24" Padding="24" MaxWidth="340" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <StackPanel>
                    <TextBlock Text="Remove fingerprint" Foreground="{StaticResource GymText}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Foreground="{StaticResource GymTextMuted}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,20">
                        <Run Text="Remove "/><Run Text="{Binding Member.Name, Mode=OneWay}"/><Run Text="'s enrolled fingerprint? They'll need to re-enroll to check in by fingerprint again."/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelRemoveFingerprintCommand}" Style="{StaticResource GymTextButton}"/>
                        <Button Content="Remove" Command="{Binding ConfirmRemoveFingerprintCommand}" Style="{StaticResource GymTextButton}" Foreground="{StaticResource GymDanger}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
