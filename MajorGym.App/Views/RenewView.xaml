<UserControl x:Class="MajorGym.App.Views.RenewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:MajorGym.App.Controls">
    <!-- Android RenewScreen: back arrow + header, current-membership FuturisticCard (ring +
         name + "Current membership" + expiry), Renewal Plan (PlanGrid), Select Start Date
         (DatePickerField), Fee, "New expiry date" success banner, Confirm Renewal. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Stretch" Margin="16,20,16,24">

            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Foreground="{StaticResource GymText}" FontFamily="Segoe MDL2 Assets" FontSize="18" Content="&#xE72B;" Padding="0,0,10,0"/>
                <TextBlock Text="RENEW MEMBERSHIP" Style="{StaticResource GymHeaderText}"/>
            </DockPanel>

            <Border Style="{StaticResource GymGlassCard}" Padding="16" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <ctl:StatusRing PhotoPath="{Binding Member.PhotoPath}" MemberName="{Binding Member.Name}" Status="{Binding Status}" RingSize="52"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Member.Name}" Foreground="{StaticResource GymText}" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="CURRENT MEMBERSHIP" Style="{StaticResource GymSectionLabel}"/>
                        <TextBlock Text="{Binding CurrentExpiryText}" Foreground="{StaticResource GymTextMuted}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="RENEWAL PLAN" Style="{StaticResource GymFieldLabel}"/>
            <ctl:PlanGrid SelectedPlan="{Binding Plan, Mode=TwoWay}" Margin="0,0,0,16"/>

            <TextBlock Text="SELECT START DATE" Style="{StaticResource GymFieldLabel}"/>
            <ctl:DatePickerField Date="{Binding StartDate, Mode=TwoWay}" Margin="0,0,0,16"/>

            <TextBlock Text="FEE (₹)" Style="{StaticResource GymFieldLabel}"/>
            <TextBox Text="{Binding FeeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GymTextBox}"
                     ctl:InputGuard.Mode="Digits" Margin="0,0,0,16"/>

            <Border Background="{StaticResource GymSuccessTint}" BorderBrush="{StaticResource GymSuccessEdge}" BorderThickness="1" CornerRadius="12" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource GymSuccess}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="NEW EXPIRY DATE" Style="{StaticResource GymSectionLabel}" Foreground="#CC10B981"/>
                        <TextBlock Text="{Binding NewExpiryText}" Foreground="{StaticResource GymSuccess}" FontWeight="Bold" FontSize="15"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Button Command="{Binding ConfirmRenewalCommand}" Style="{StaticResource GymPrimaryButtonLarge}" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Confirm Renewal" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
