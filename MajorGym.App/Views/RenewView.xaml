<UserControl x:Class="MajorGym.App.Views.RenewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16,20,16,90">
        <StackPanel MaxWidth="480" HorizontalAlignment="Left">
            <TextBlock Text="RENEW MEMBERSHIP" Style="{StaticResource GymHeading}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource GymCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding Member.Name}" Foreground="{StaticResource GymText}" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Current membership" Style="{StaticResource GymBody}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding CurrentExpiryText}" Foreground="{StaticResource GymTextMuted}" FontSize="12"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Renewal Plan" Style="{StaticResource GymBody}" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding PlanOptions}" SelectedItem="{Binding Plan}" Margin="0,0,0,14" Padding="8"/>

            <TextBlock Text="Start Date" Style="{StaticResource GymBody}" Margin="0,0,0,6"/>
            <DatePicker SelectedDate="{Binding StartDate}" Margin="0,0,0,14" Padding="6"/>

            <TextBlock Text="Fee (₹)" Style="{StaticResource GymBody}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding FeeText, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,14"
                     Background="{StaticResource GymSurface2}" Foreground="{StaticResource GymText}" BorderBrush="{StaticResource GymBorder}"/>

            <Border Background="#2410B981" BorderBrush="{StaticResource GymSuccess}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="New expiry date" Foreground="{StaticResource GymSuccess}" FontSize="11" Opacity="0.8"/>
                    <TextBlock Text="{Binding NewExpiryText}" Foreground="{StaticResource GymSuccess}" FontWeight="Bold" FontSize="16"/>
                </StackPanel>
            </Border>

            <Button Content="Confirm Renewal" Style="{StaticResource GymPrimaryButton}" Command="{Binding ConfirmRenewalCommand}" Margin="0,0,0,10"/>
            <Button Content="Back" Command="{Binding BackCommand}" HorizontalAlignment="Left" Padding="14,8"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
