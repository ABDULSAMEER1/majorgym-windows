<UserControl x:Class="MajorGym.App.Views.MembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:MajorGym.App.Controls">
    <!-- Android MembersScreen: title, search field ("Search by name, phone or ID proof"),
         scrollable list of the shared MemberRow. -->
    <DockPanel Margin="16,20,16,0">
        <TextBlock Text="MEMBERS" Style="{StaticResource GymHeaderText}" DockPanel.Dock="Top" Margin="0,0,0,12"/>
        <TextBox DockPanel.Dock="Top" Style="{StaticResource GymTextBox}" Margin="0,0,0,14"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Tag="Search by name, phone or ID proof"/>
        <ItemsControl Style="{StaticResource GymVirtualList}" ItemsSource="{Binding Rows}" Padding="0,0,0,90">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctl:MemberRowView Margin="0,0,0,10"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
    </DockPanel>
</UserControl>
