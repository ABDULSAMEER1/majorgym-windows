<UserControl x:Class="MajorGym.App.Views.MembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16,20,16,90">
        <TextBlock Text="MEMBERS" Style="{StaticResource GymHeading}" DockPanel.Dock="Top" Margin="0,0,0,12"/>
        <TextBox DockPanel.Dock="Top" Margin="0,0,0,12" Padding="10,8"
                 Background="{StaticResource GymSurface2}" Foreground="{StaticResource GymText}"
                 BorderBrush="{StaticResource GymBorder}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Tag="Search by name or phone"/>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GymCard}" Margin="0,0,0,8" Cursor="Hand"
                                MouseLeftButtonUp="Row_Click" Tag="{Binding OpenProfile}">
                            <DockPanel>
                                <Border Width="10" Height="10" CornerRadius="5" DockPanel.Dock="Right" VerticalAlignment="Center"
                                        Background="{Binding StatusBrush}"/>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Member.Name}" Foreground="{StaticResource GymText}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Member.Phone}" Style="{StaticResource GymBody}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource GymBody}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
