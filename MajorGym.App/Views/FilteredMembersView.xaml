<UserControl x:Class="MajorGym.App.Views.FilteredMembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,20,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Command="{Binding BackCommand}" Background="Transparent"
                    BorderThickness="0" Foreground="{StaticResource GymText}" Padding="0,0,10,0"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource GymHeading}" FontSize="18"/>
        </StackPanel>

        <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,14"
                 Background="{StaticResource GymSurface2}" Foreground="{StaticResource GymText}" BorderBrush="{StaticResource GymBorder}"
                 Visibility="{Binding ShowSearch, Converter={StaticResource BoolToVis}}"
                 Tag="Search by name, phone or ID proof"/>

        <Grid Grid.Row="2">
            <TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource GymTextFaint}" FontSize="13"
                       Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}"/>
            <ScrollViewer Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,0,90">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GymCard}" Margin="0,0,0,10" Padding="14" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenProfile}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Member.Name}" Foreground="{StaticResource GymText}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding Member.Phone}" Foreground="{StaticResource GymTextMuted}" FontSize="12" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Member.Fee, StringFormat='₹{0:N0}'}" Foreground="{StaticResource GymDanger}"
                                               VerticalAlignment="Center" FontWeight="SemiBold"
                                               Visibility="{Binding DataContext.ShowDueAmount, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
