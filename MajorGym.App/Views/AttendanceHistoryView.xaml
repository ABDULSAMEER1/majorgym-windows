<UserControl x:Class="MajorGym.App.Views.AttendanceHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{StaticResource GymBg}">
        <StackPanel Margin="20">
            <Button Content="&#8592; Back" Command="{Binding BackCommand}" HorizontalAlignment="Left"
                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource GymTextMuted}" Margin="0,0,0,12"/>

            <Border Style="{StaticResource GymCard}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Border Width="56" Height="56" CornerRadius="28" ClipToBounds="True" Background="{StaticResource GymSurface2}">
                        <Image Source="{Binding Photo}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Member.Name}" Style="{StaticResource GymHeading}" FontSize="18"/>
                        <TextBlock Text="{Binding Member.Phone}" Style="{StaticResource GymBody}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GymCard}" Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Foreground="{StaticResource GymAccent}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center">
                        <Run Text="{Binding AttendancePercentage, Mode=OneWay}"/><Run Text="%"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource GymBody}" HorizontalAlignment="Center">
                        <Run Text="{Binding AttendedDays, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding EligibleDays, Mode=OneWay}"/><Run Text=" days"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource GymBody}" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Run Text="Since "/><Run Text="{Binding MembershipStartLabel, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="History" Style="{StaticResource GymHeading}" FontSize="16" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GymCard}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Date}" Foreground="{StaticResource GymText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Session}" Style="{StaticResource GymBody}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding TimeOfDay}" Style="{StaticResource GymBody}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
