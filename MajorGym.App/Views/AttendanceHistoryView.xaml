<UserControl x:Class="MajorGym.App.Views.AttendanceHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MajorGym.App.Controls">
    <UserControl.Resources>
        <!-- Android Ad* palette (AttendanceLogsScreen.kt) -->
        <SolidColorBrush x:Key="AdNeonCyan" Color="#FF29D3FF"/>
        <SolidColorBrush x:Key="AdNeonBlue" Color="#FF2F8BFF"/>
        <SolidColorBrush x:Key="AdLabelBlue" Color="#FF6FA8FF"/>
        <SolidColorBrush x:Key="AdGold" Color="#FFFFB020"/>
        <SolidColorBrush x:Key="AdTeal" Color="#FF34F5C5"/>
        <SolidColorBrush x:Key="AdSoftBorder" Color="#552F8BFF"/>
        <LinearGradientBrush x:Key="AdPanelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EB0C1A3D" Offset="0"/><GradientStop Color="#EB060E27" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AdRingBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF29D3FF" Offset="0"/><GradientStop Color="#FF2F8BFF" Offset="0.55"/><GradientStop Color="#FF7A5CFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AdArcBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF29D3FF" Offset="0"/><GradientStop Color="#FF2F8BFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AdCrownBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFE08A" Offset="0"/><GradientStop Color="#FFF59E0B" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="AdPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AdPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AdSoftBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="AdSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource GymText}"/>
            <Setter Property="FontFamily" Value="{StaticResource GymHeaderFontBold}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Backdrop: deep navy gradient with soft blue / violet glows -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF060E27" Offset="0"/><GradientStop Color="#FF03071A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Ellipse Width="420" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-160,0,0" IsHitTestVisible="False">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#302F8BFF" Offset="0"/><GradientStop Color="#002F8BFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-180,-140" IsHitTestVisible="False">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#287A5CFF" Offset="0"/><GradientStop Color="#007A5CFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,20,16,24">

                <!-- Header: back + "MEMBER PROFILE" + tagline -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Command="{Binding BackCommand}" Style="{StaticResource GymTextButton}" Padding="6,4" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource GymIconFont}" FontSize="18" Foreground="{StaticResource GymText}"/>
                    </Button>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MEMBER PROFILE" Style="{StaticResource GymHeaderText}" FontSize="22" HorizontalAlignment="Left"/>
                        <TextBlock Text="Stronger Members  &#8226;  Healthier Tomorrow" Foreground="{StaticResource AdNeonCyan}" FontSize="12" FontWeight="Medium" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Hero card: avatar ring, name / phone / status chip, attendance % ring -->
                <Border Style="{StaticResource AdPanel}" CornerRadius="26" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="84" Height="84" VerticalAlignment="Center">
                            <Ellipse Stroke="{StaticResource AdRingBrush}" StrokeThickness="3">
                                <Ellipse.Effect><DropShadowEffect Color="#FF29D3FF" BlurRadius="14" ShadowDepth="0" Opacity="0.5"/></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Margin="6" Fill="#FF0E2350"/>
                            <Ellipse Margin="6" Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}">
                                <Ellipse.Fill><ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill"/></Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding Initials}" Foreground="{StaticResource AdNeonCyan}" FontFamily="{StaticResource GymHeaderFontBold}"
                                       FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Member.Name}" Foreground="{StaticResource GymText}" FontFamily="{StaticResource GymHeaderFontBold}"
                                       FontWeight="Bold" FontSize="24" TextWrapping="Wrap" MaxHeight="64"/>
                            <TextBlock Text="{Binding Member.Phone}" Foreground="#FF4C9BFF" FontSize="17" FontWeight="Medium" Margin="0,2,0,0"/>
                            <Border Background="{Binding StatusTint}" BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="14"
                                    Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StatusGlyph}" FontFamily="{StaticResource GymIconFont}" FontSize="12" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontFamily="{StaticResource GymHeaderFontBold}"
                                               FontWeight="Bold" FontSize="13" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Column="2" Width="92" Height="92" VerticalAlignment="Center">
                            <Ellipse Fill="#FF06122E"/>
                            <controls:ArcProgress Value="{Binding PercentValue}" Thickness="8" TrackBrush="#FF0F2A5C" ProgressBrush="{StaticResource AdArcBrush}"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PercentText}" Foreground="{StaticResource GymText}" FontFamily="{StaticResource GymHeaderFont}"
                                           FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding DaysLeftLabel}" Foreground="{StaticResource AdLabelBlue}" FontSize="10" FontWeight="Medium"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="70"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Membership Details -->
                <Border Style="{StaticResource AdPanel}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Viewbox Width="26" Height="26">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{StaticResource AdCrownBrush}" Data="M2,19 L1,7 L7,12 L12,3 L17,12 L23,7 L22,19 Z"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="20" Width="20" Height="3" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource AdCrownBrush}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="MEMBERSHIP DETAILS" Style="{StaticResource AdSectionTitle}" Margin="10,0,0,0"/>
                        </StackPanel>

                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#8377;" FontSize="20" Width="30" Foreground="{StaticResource AdNeonCyan}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Plan" Foreground="{StaticResource AdLabelBlue}" FontSize="17" FontWeight="Medium" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding PlanText}" Foreground="{StaticResource GymText}" FontSize="17" FontWeight="SemiBold"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource AdSoftBorder}"/>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE787;" FontFamily="{StaticResource GymIconFont}" FontSize="20" Width="30" Foreground="{StaticResource AdNeonCyan}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Start Date" Foreground="{StaticResource AdLabelBlue}" FontSize="17" FontWeight="Medium" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding StartDateText}" Foreground="{StaticResource GymText}" FontSize="17" FontWeight="SemiBold"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource AdSoftBorder}"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE787;" FontFamily="{StaticResource GymIconFont}" FontSize="20" Width="30" Foreground="{StaticResource AdNeonCyan}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Expiry Date" Foreground="{StaticResource AdLabelBlue}" FontSize="17" FontWeight="Medium" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding ExpiryDateText}" Foreground="{StaticResource GymText}" FontSize="17" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Attendance Progress -->
                <Border Style="{StaticResource AdPanel}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="72" Height="72" VerticalAlignment="Center">
                            <Ellipse Stroke="{StaticResource AdRingBrush}" StrokeThickness="3"/>
                            <Viewbox Width="38" Height="38">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{StaticResource AdNeonCyan}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M3.5,13 A8.5,8.5 0 0 1 20.5,13 M6.5,15 A5.5,5.5 0 0 1 17.5,15 M9.5,17 A2.5,2.5 0 0 1 14.5,17 M12,12 V21 M7.5,20 V18 M16.5,20 V17 M5,17 V15 M19,18 V15"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ATTENDANCE PROGRESS" Style="{StaticResource AdSectionTitle}"/>
                            <Grid Margin="0,8,0,8">
                                <TextBlock Text="Attended Days" Foreground="{StaticResource AdLabelBlue}" FontSize="16" FontWeight="Medium"/>
                                <TextBlock Text="{Binding AttendedText}" Foreground="{StaticResource GymText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="12" CornerRadius="6" Background="#FF0F2A5C" ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding ProgressFilled}"/>
                                        <ColumnDefinition Width="{Binding ProgressRest}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="6" Background="{StaticResource AdArcBrush}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Attendance History -->
                <StackPanel Orientation="Horizontal" Margin="4,10,0,10">
                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource GymIconFont}" FontSize="22" Foreground="{StaticResource AdGold}" VerticalAlignment="Center"/>
                    <TextBlock Text="ATTENDANCE HISTORY" Style="{StaticResource AdSectionTitle}" Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock Text="No attendance recorded yet." Foreground="{StaticResource GymTextFaint}" FontSize="13" Margin="0,4,0,0"
                           Visibility="{Binding HasNoRecords, Converter={StaticResource BoolToVis}}"/>

                <ItemsControl ItemsSource="{Binding Months}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Header}" Foreground="{StaticResource GymText}" FontFamily="{StaticResource GymHeaderFontBold}"
                                           FontWeight="Bold" FontSize="19" Margin="4,10,0,8"/>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#E60A1631" BorderBrush="{StaticResource AdSoftBorder}" BorderThickness="1" CornerRadius="18" Padding="10" Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#FF0E2350" BorderBrush="{StaticResource AdSoftBorder}" BorderThickness="1" CornerRadius="14" Padding="12,8" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Day}" Foreground="{StaticResource GymText}" FontFamily="{StaticResource GymHeaderFont}" FontSize="26" VerticalAlignment="Center"/>
                                                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Month}" Foreground="{StaticResource AdLabelBlue}" FontSize="14" FontWeight="Medium"/>
                                                                <TextBlock Text="{Binding Year}" Foreground="{StaticResource AdLabelBlue}" FontSize="14" FontWeight="Medium"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Width="44" Height="44" CornerRadius="22" Background="#3310D9A0" BorderBrush="#FF10D9A0" BorderThickness="1.5" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource GymIconFont}" FontSize="20" Foreground="{StaticResource AdTeal}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource AdTeal}" FontFamily="{StaticResource GymHeaderFontBold}" FontWeight="Bold" FontSize="19"/>
                                                        <TextBlock Text="{Binding SessionLabel}" Foreground="{StaticResource AdLabelBlue}" FontSize="15" FontWeight="Medium"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
