<UserControl x:Class="MajorGym.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16,20,16,90">
        <StackPanel>
            <TextBlock Text="MAJOR GYM" Style="{StaticResource GymHeaderText}" Margin="0,0,0,16"/>

            <UniformGrid Columns="2" Rows="2">
                <Border Style="{StaticResource GymCard}" Margin="0,0,5,10" Cursor="Hand"
                        MouseLeftButtonUp="StatCard_Click" Tag="{Binding GoTotal}">
                    <StackPanel>
                        <TextBlock Text="Total Members" Style="{StaticResource GymBody}"/>
                        <TextBlock Text="{Binding TotalDisplay}" Foreground="{StaticResource GymText}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GymCard}" Margin="5,0,0,10" Cursor="Hand"
                        MouseLeftButtonUp="StatCard_Click" Tag="{Binding GoActive}">
                    <StackPanel>
                        <TextBlock Text="Active" Style="{StaticResource GymBody}"/>
                        <TextBlock Text="{Binding ActiveDisplay}" Foreground="{StaticResource GymSuccess}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GymCard}" Margin="0,0,5,10" Cursor="Hand"
                        MouseLeftButtonUp="StatCard_Click" Tag="{Binding GoExpiring}">
                    <StackPanel>
                        <TextBlock Text="Expiring Soon" Style="{StaticResource GymBody}"/>
                        <TextBlock Text="{Binding ExpiringDisplay}" Foreground="{StaticResource GymWarning}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GymCard}" Margin="5,0,0,10" Cursor="Hand"
                        MouseLeftButtonUp="StatCard_Click" Tag="{Binding GoExpired}">
                    <StackPanel>
                        <TextBlock Text="Expired" Style="{StaticResource GymBody}"/>
                        <TextBlock Text="{Binding ExpiredDisplay}" Foreground="{StaticResource GymDanger}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource GymCard}" Margin="0,4,0,10" Cursor="Hand"
                    MouseLeftButtonUp="StatCard_Click" Tag="{Binding GoDue}">
                <DockPanel>
                    <TextBlock Text="{Binding DueDisplay}" Foreground="{StaticResource GymDanger}" FontSize="18" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Due Members" Foreground="{StaticResource GymText}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Members with an outstanding due amount" Style="{StaticResource GymBody}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource GymCard}" Margin="0,0,0,10" Cursor="Hand"
                    MouseLeftButtonUp="StatCard_Click" Tag="{Binding GoExpiredArchive}">
                <StackPanel>
                    <TextBlock Text="Expired Archive" Foreground="{StaticResource GymText}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Members expired 30+ days" Style="{StaticResource GymBody}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Button Content="+ Add Member" Style="{StaticResource GymPrimaryButton}" Margin="0,10,0,0"
                    HorizontalAlignment="Left" Command="{Binding GoAddMember}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
