<UserControl x:Class="MajorGym.App.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{StaticResource GymBg}">
        <StackPanel Margin="20" >
            <Button Content="&#8592; Back" Command="{Binding BackCommand}" HorizontalAlignment="Left"
                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource GymTextMuted}" Margin="0,0,0,12"/>
            <TextBlock Text="Attendance" Style="{StaticResource GymHeading}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding GymName}" Style="{StaticResource GymBody}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource GymCard}" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="{Binding QrImage}" Width="220" Height="220"/>
                    <TextBlock Text="Members scan this code to check in" Style="{StaticResource GymBody}"
                               Margin="0,12,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Button Content="View Attendance Logs" Command="{Binding GoLogsCommand}"
                    Style="{StaticResource GymPrimaryButton}" Margin="0,20,0,0" HorizontalAlignment="Stretch"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
