<UserControl x:Class="MajorGym.App.Views.AddEditMemberView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:MajorGym.App.Controls">
    <!-- Android AddEditMemberScreen, same order: back arrow + header, "Enrollment Telemetry" avatar
         (tap = choose photo), Full Name, Phone Number, ID Proof (Optional), ID Proof Photo (Optional),
         Joining Date, Membership Plan, Due Amount (Optional), calculated expiry projection, primary button. -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" HorizontalAlignment="Stretch" Margin="16,20,16,24">

                <DockPanel Margin="0,0,0,20">
                    <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{StaticResource GymText}" FontFamily="Segoe MDL2 Assets" FontSize="18" Content="&#xE72B;" Padding="0,0,10,0"/>
                    <TextBlock Text="{Binding HeaderText}" Style="{StaticResource GymHeaderText}"/>
                </DockPanel>

                <TextBlock Text="ENROLLMENT TELEMETRY" Style="{StaticResource GymSectionLabel}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <Grid Width="104" Height="104" HorizontalAlignment="Center" Cursor="Hand">
                    <Grid.Effect><DropShadowEffect Color="#FF00F0FF" BlurRadius="14" ShadowDepth="0" Opacity="0.30"/></Grid.Effect>
                    <Ellipse Width="96" Height="96" Fill="{StaticResource GymSurfaceCard}" Stroke="{StaticResource GymAccentBright}" StrokeThickness="2"/>
                    <Ellipse Width="92" Height="92" Visibility="{Binding PhotoPath, Converter={StaticResource PathExistsToVis}}">
                        <Ellipse.Fill><ImageBrush ImageSource="{Binding PhotoPath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill"/></Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource GymAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding PhotoPath, Converter={StaticResource PathExistsToVis}, ConverterParameter=Invert}"/>
                    <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource GymAccentGradient}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#FF06121A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button Command="{Binding ChoosePhotoCommand}" Opacity="0" Cursor="Hand" ToolTip="Choose profile photo"/>
                </Grid>
                <TextBlock Text="Profile Photo · Face Recognition Ready" Foreground="{StaticResource GymTextFaint}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,10,0,20"/>

                <!-- Full Name -->
                <TextBlock Text="FULL NAME" Style="{StaticResource GymFieldLabel}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GymTextBox}" Margin="0,0,0,16"/>

                <!-- Phone Number -->
                <TextBlock Text="PHONE NUMBER" Style="{StaticResource GymFieldLabel}"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" ctl:InputGuard.Mode="Digits">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource GymTextBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PhoneTaken}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource GymDanger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="This phone number is already registered." Style="{StaticResource GymFieldError}"
                           Visibility="{Binding PhoneTaken, Converter={StaticResource BoolToVis}}"/>
                <Border Height="16"/>

                <!-- ID Proof -->
                <TextBlock Text="ID PROOF (OPTIONAL)" Style="{StaticResource GymFieldLabel}"/>
                <TextBox Text="{Binding IdProof, UpdateSourceTrigger=PropertyChanged}" Tag="Enter ID Number (Optional)"
                         ctl:InputGuard.Mode="AsciiLettersAndDigits" ctl:InputGuard.RejectedCommand="{Binding IdProofRejectedCommand}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource GymTextBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IdProofError}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource GymDanger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="Only letters and numbers are allowed." Style="{StaticResource GymFieldError}"
                           Visibility="{Binding IdProofError, Converter={StaticResource BoolToVis}}"/>
                <Border Height="16"/>

                <!-- ID Proof Photo -->
                <TextBlock Text="ID PROOF PHOTO (OPTIONAL)" Style="{StaticResource GymFieldLabel}"/>
                <TextBlock Text="Capture or upload an image of the member's ID proof for future verification."
                           Foreground="{StaticResource GymTextFaint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Visibility="{Binding HasIdProofPhoto, Converter={StaticResource BoolToVis}}">
                    <Border CornerRadius="12" Height="160" ClipToBounds="True">
                        <Border.Background><ImageBrush ImageSource="{Binding IdProofPhotoPath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill"/></Border.Background>
                    </Border>
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button Content="Replace" Command="{Binding ChooseIdPhotoCommand}" Style="{StaticResource GymOutlinedButton}" Margin="0,0,4,0"/>
                        <Button Content="Delete" Command="{Binding AskDeleteIdPhotoCommand}" Style="{StaticResource GymOutlinedButton}" Foreground="{StaticResource GymDanger}" Margin="4,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
                <Button Command="{Binding ChooseIdPhotoCommand}" Height="96" Cursor="Hand"
                        Visibility="{Binding HasIdProofPhoto, Converter={StaticResource InverseBoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{StaticResource GymBg}" BorderBrush="{StaticResource GymBorderSubtle}" BorderThickness="1" CornerRadius="12">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource GymViolet}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Tap to add ID Proof Photo" Foreground="{StaticResource GymTextMuted}" FontSize="12" FontWeight="Medium" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Border Height="16"/>

                <!-- Joining Date -->
                <TextBlock Text="JOINING DATE" Style="{StaticResource GymFieldLabel}"/>
                <ctl:DatePickerField Date="{Binding Joined, Mode=TwoWay}" Margin="0,0,0,16"/>

                <!-- Membership Plan -->
                <TextBlock Text="MEMBERSHIP PLAN" Style="{StaticResource GymFieldLabel}"/>
                <ctl:PlanGrid SelectedPlan="{Binding Plan, Mode=TwoWay}" Margin="0,0,0,8"/>

                <!-- Due Amount -->
                <TextBlock Text="DUE AMOUNT (₹) (OPTIONAL)" Style="{StaticResource GymFieldLabel}"/>
                <TextBox Text="{Binding FeeText, UpdateSourceTrigger=PropertyChanged}" Tag="Enter Due Amount (Optional)"
                         Style="{StaticResource GymTextBox}" ctl:InputGuard.Mode="Digits" Margin="0,0,0,16"/>

                <!-- Calculated expiry projection -->
                <Border Background="{StaticResource GymSuccessTint}" BorderBrush="{StaticResource GymSuccessEdge}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource GymSuccess}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="CALCULATED EXPIRY PROJECTION" Style="{StaticResource GymSectionLabel}" Foreground="#CC10B981"/>
                            <TextBlock Text="{Binding ExpiryPreview}" Foreground="{StaticResource GymSuccess}" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="{Binding SaveError}" Style="{StaticResource GymFieldError}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding SaveError, Converter={StaticResource NullToVis}}"/>

                <Button Command="{Binding SaveCommand}" Style="{StaticResource GymPrimaryButtonLarge}" Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SaveButtonText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- "Remove ID Proof Photo?" AlertDialog -->
        <Grid Background="{StaticResource GymScrim}" Visibility="{Binding ConfirmDeleteIdPhoto, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource GymSurfaceCard}" CornerRadius="24" Padding="24" MaxWidth="340" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <StackPanel>
                    <TextBlock Text="Remove ID Proof Photo?" Foreground="{StaticResource GymText}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="This can't be undone." Foreground="{StaticResource GymTextMuted}" FontSize="14" Margin="0,12,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelDeleteIdPhotoCommand}" Style="{StaticResource GymTextButton}"/>
                        <Button Content="Delete" Command="{Binding ConfirmDeleteIdPhotoCommand}" Style="{StaticResource GymTextButton}" Foreground="{StaticResource GymDanger}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
