<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64;x86</Platforms>
    <RootNamespace>MajorGym.App</RootNamespace>
    <AssemblyName>MajorGym</AssemblyName>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exo 2 header font, copied from the Android app's res/font (SIL OFL 1.1 — license text
         alongside). Embedded so the Major Gym header typeface travels with the EXE. -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <!-- Check-in sounds (same five clips as Android res/raw). Copied beside MajorGym.exe as Assets\Audio\*.mp3. -->
  <ItemGroup>
    <None Include="Assets\Audio\*.mp3">
      <Link>Assets\Audio\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- SecuGen Universal Driver Installer (v3.0.0.3). Shipped beside MajorGym.exe so a PC without the SecuGen USB
       driver can install it from the Enroll Fingerprint screen ("Install Scanner Driver" button). The driver
       needs administrator rights, so it is launched (UAC prompt) rather than silently installed. -->
  <ItemGroup>
    <None Include="..\vendor\SecuGenDriver\SgDrvSetupUniversal.exe">
      <Link>Drivers\SgDrvSetupUniversal.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MajorGym.Data\MajorGym.Data.csproj" />
    <ProjectReference Include="..\MajorGym.Fingerprint\MajorGym.Fingerprint.csproj" />
    <ProjectReference Include="..\MajorGym.Kiosk\MajorGym.Kiosk.csproj" />
  </ItemGroup>

</Project>
