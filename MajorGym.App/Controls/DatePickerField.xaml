<UserControl x:Class="MajorGym.App.Controls.DatePickerField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border x:Name="Field" Background="{StaticResource GymSurfaceCard}" BorderBrush="{StaticResource GymBorder}"
                BorderThickness="1" CornerRadius="10" Padding="14" Cursor="Hand" MouseLeftButtonUp="Field_Click">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GymAccent}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="DateText" Foreground="{StaticResource GymText}" FontWeight="Medium" FontSize="14"/>
            </DockPanel>
        </Border>
        <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=Field}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{StaticResource GymSurfaceCard}" BorderBrush="{StaticResource GymAccent}" BorderThickness="1"
                    CornerRadius="10" Padding="6" Margin="0,4,0,0">
                <Calendar x:Name="Picker" SelectedDatesChanged="Picker_SelectedDatesChanged" PreviewMouseUp="Picker_PreviewMouseUp"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
