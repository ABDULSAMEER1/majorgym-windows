<Window x:Class="MajorGym.App.Controls.PhotoViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized" ShowInTaskbar="False"
        Background="#F2000000" KeyDown="Window_KeyDown" MouseLeftButtonUp="Window_Click">
    <!-- Android FullScreenPhotoViewer: dark full-screen scrim, the photo fitted to the screen, a
         title, tap anywhere (or Esc) to close. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource GymText}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Foreground="{StaticResource GymText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <Image x:Name="Picture" Grid.Row="1" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
    </Grid>
</Window>
