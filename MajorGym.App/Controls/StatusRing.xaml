<UserControl x:Class="MajorGym.App.Controls.StatusRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Android StatusRing: status-coloured 2dp ring with a soft glow, 3dp gap, Surface2 disc,
         photo (cropped to a circle) or the member's initials in the accent colour. -->
    <Grid x:Name="Root">
        <Ellipse x:Name="Ring" StrokeThickness="2" Fill="{StaticResource GymSurface2}"/>
        <Grid x:Name="Inner" Margin="5">
            <Ellipse x:Name="Photo" Visibility="Collapsed"/>
            <TextBlock x:Name="Initials" Foreground="{StaticResource GymAccent}" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
